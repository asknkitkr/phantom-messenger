# Phantom Messenger — .gitignore

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Virtual Environment ──────────────────────────────────
.venv/
venv/
ENV/

# ── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Application Data (user-specific, never commit) ──────
# Database, keys, and logs live under OS-specific app dirs
# but if somehow generated in the project tree:
*.db
*.db-journal
phantom.log

# ── Secrets & Keys (NEVER commit) ────────────────────────
*.pem
*.key
keys/
